{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sproutos.me/deployment-templates/app-manifest-v1.schema.json",
  "title": "SproutOS deployment-template app manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "pitch", "description_md", "homepage", "repository", "license", "platform", "readiness", "plugin", "deployment", "services", "user_inputs", "generated_inputs"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/token" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "pitch": { "type": "string", "minLength": 1, "maxLength": 240 },
    "description_md": { "type": "string", "minLength": 1 },
    "homepage": { "oneOf": [{ "type": "string", "format": "uri", "pattern": "^https://" }, { "type": "null" }] },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "commit"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "commit": { "$ref": "#/$defs/commit" }
      }
    },
    "license": { "type": "string", "minLength": 1 },
    "platform": { "enum": ["web", "android"] },
    "readiness": { "$ref": "#/$defs/readiness" },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "protocol_version"],
      "properties": {
        "repository": { "type": "string", "pattern": "^ghcr\\.io/[a-z0-9._-]+(?:/[a-z0-9._-]+)+$" },
        "digest": { "$ref": "#/$defs/digest" },
        "protocol_version": { "const": 1 }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "runtime", "architecture", "migration", "required_capabilities"],
      "properties": {
        "preset": { "$ref": "#/$defs/token" },
        "runtime": { "$ref": "#/$defs/token" },
        "architecture": { "enum": ["arm64", "x86_64"] },
        "migration": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path"],
              "properties": {
                "kind": { "const": "artifact" },
                "path": { "$ref": "#/$defs/relativePath" }
              }
            }
          ]
        },
        "required_capabilities": { "type": "array", "items": { "$ref": "#/$defs/token" }, "uniqueItems": true }
      }
    },
    "services": { "type": "array", "items": { "$ref": "#/$defs/service" } },
    "user_inputs": { "type": "array", "items": { "$ref": "#/$defs/userInput" } },
    "generated_inputs": { "type": "array", "items": { "$ref": "#/$defs/generatedInput" } }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "environment": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\.git(?:/|$))(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//).+$"
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blocked_reasons", "e2e_evidence"],
      "properties": {
        "status": { "enum": ["blocked", "live", "retired"] },
        "blocked_reasons": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "e2e_evidence": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["workflow_run_url", "tested_at", "upstream_commit", "plugin_digest"],
              "properties": {
                "workflow_run_url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/MySproutOS/Deployment-Templates/actions/runs/[0-9]+$" },
                "tested_at": { "type": "string", "format": "date-time" },
                "upstream_commit": { "$ref": "#/$defs/commit" },
                "plugin_digest": { "$ref": "#/$defs/digest" }
              }
            }
          ]
        }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] }, "then": { "properties": { "blocked_reasons": { "minItems": 1 }, "e2e_evidence": { "type": "null" } } } },
        { "if": { "properties": { "status": { "const": "live" } }, "required": ["status"] }, "then": { "properties": { "blocked_reasons": { "maxItems": 0 }, "e2e_evidence": { "type": "object" } } } },
        { "if": { "properties": { "status": { "const": "retired" } }, "required": ["status"] }, "then": { "properties": { "blocked_reasons": { "maxItems": 0 } } } }
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "bindings"],
      "properties": {
        "key": { "$ref": "#/$defs/token" },
        "kind": { "enum": ["postgres", "valkey", "elasticsearch", "object_storage"] },
        "bindings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/binding" } }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "output"],
      "properties": {
        "environment": { "$ref": "#/$defs/environment" },
        "output": { "enum": ["connection_url", "endpoint", "username", "password", "region", "bucket", "access_key_id", "secret_access_key", "force_path_style"] }
      }
    },
    "userInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "environment", "required"],
      "properties": {
        "key": { "$ref": "#/$defs/token" },
        "type": { "enum": ["string", "url", "integer", "boolean"] },
        "environment": { "$ref": "#/$defs/environment" },
        "required": { "type": "boolean" }
      }
    },
    "generatedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "generator", "bytes", "environment"],
      "properties": {
        "key": { "$ref": "#/$defs/token" },
        "generator": { "const": "random_base64url" },
        "bytes": { "type": "integer", "minimum": 32, "maximum": 128 },
        "environment": { "$ref": "#/$defs/environment" }
      }
    }
  }
}
