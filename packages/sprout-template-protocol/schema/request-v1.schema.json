{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sproutos.me/template-protocol/request-v1.schema.json",
  "title": "SproutOS template apply request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "workspace", "template", "deployment", "services", "user_inputs", "generated_inputs"],
  "properties": {
    "protocol_version": { "const": 1 },
    "workspace": { "type": "string", "minLength": 1 },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "catalogue_digest", "manifest_digest", "plugin_digest", "upstream_repository", "upstream_commit"],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "catalogue_digest": { "$ref": "#/$defs/digest" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "plugin_digest": { "$ref": "#/$defs/digest" },
        "upstream_repository": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "upstream_commit": { "$ref": "#/$defs/commit" }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "capabilities"],
      "properties": {
        "preset": { "$ref": "#/$defs/token" },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/token" },
          "uniqueItems": true
        }
      }
    },
    "services": {
      "type": "array",
      "items": { "$ref": "#/$defs/service" }
    },
    "user_inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/userInput" }
    },
    "generated_inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/generatedInput" }
    }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "environment": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "bindings"],
      "properties": {
        "key": { "$ref": "#/$defs/token" },
        "kind": { "enum": ["postgres", "valkey", "elasticsearch", "object_storage"] },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/binding" }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "output"],
      "properties": {
        "environment": { "$ref": "#/$defs/environment" },
        "output": {
          "enum": ["connection_url", "endpoint", "username", "password", "region", "bucket", "access_key_id", "secret_access_key", "force_path_style"]
        }
      }
    },
    "userInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "environment", "required"],
      "properties": {
        "key": { "$ref": "#/$defs/token" },
        "type": { "enum": ["string", "url", "integer", "boolean"] },
        "environment": { "$ref": "#/$defs/environment" },
        "required": { "type": "boolean" }
      }
    },
    "generatedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "generator", "bytes", "environment"],
      "properties": {
        "key": { "$ref": "#/$defs/token" },
        "generator": { "const": "random_base64url" },
        "bytes": { "type": "integer", "minimum": 32, "maximum": 128 },
        "environment": { "$ref": "#/$defs/environment" }
      }
    }
  }
}
